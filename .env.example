# Ari Trading Journal — Environment Variables
# Copy this file to .env, add your NVIDIA key, and restart the server.
# Keep .env local and never paste the key into frontend code.

APP_ENV=development

# ─── NVIDIA Hosted LLM ────────────────────────────────────────────────────────
# Get your free API key at https://build.nvidia.com
# The AI assistant is optional — the app fully works without it.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=30

# ─── Application ──────────────────────────────────────────────────────────────
PORT=5001
FRONTEND_ORIGIN=http://localhost:3000
